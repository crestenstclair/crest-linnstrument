{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LinnStrument Simulator",
  "version": "0.3.0-dev.3",
  "identifier": "dev.crest.linnstrument-sim",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "host",
        "title": "Crest Performance \u00b7 standalone test host",
        "url": "host.html",
        "width": 860,
        "height": 760
      },
      {
        "label": "main",
        "title": "LinnStrument \u00b7 firmware replica",
        "width": 1280,
        "height": 760,
        "minWidth": 860,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "capabilities": []
    }
  },
  "bundle": {
    "active": false
  }
}
